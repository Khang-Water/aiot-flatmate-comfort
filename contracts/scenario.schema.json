{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "SimulationScenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name_vi", "description_vi", "duration_minutes", "actions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name_vi": {"type": "string", "minLength": 1},
    "description_vi": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "minimum": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_minute", "target", "value"],
      "properties": {
        "at_minute": {"type": "integer", "minimum": 0},
        "target": {
          "type": "string",
          "enum": [
            "environment.temperature_c", "environment.humidity_percent", "environment.co2_ppm",
            "environment.pm25_ug_m3", "environment.ambient_light_lux", "environment.noise_db",
            "occupancy.room_present", "occupancy.bed_occupied", "occupancy.desk_occupied",
            "openings.window_state", "openings.curtain_position_percent", "power.computer_power_watts",
            "devices.ac", "devices.fan", "devices.main_light", "devices.bedside_light",
            "devices.air_purifier", "devices.curtain", "devices.humidity_device", "inferred_context"
          ]
        },
        "value": {},
        "note": {"type": "string"}
      }
    }
  }
}
