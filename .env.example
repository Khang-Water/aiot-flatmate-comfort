# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45

# Offline Vietnamese TTS; VieNeu v3 Turbo ONNX int8 is primary, Supertonic is fallback
TTS_ENGINE=vieneu
VIENEU_VOICE=Mai Anh
SUPERTONIC_VOICE=F4
SUPERTONIC_STEPS=12
SUPERTONIC_SPEED=1.0

# Local Vietnamese ASR; small is much faster on CPU for short apartment commands
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=2

# API
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/flatmate.db

# Simulation
SIMULATION_SEED=42
SIMULATION_TICK_SECONDS=2
SIMULATION_MINUTES_PER_TICK=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
