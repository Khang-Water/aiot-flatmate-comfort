# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45

# Local Vietnamese TTS (first use downloads Supertonic model assets, about 400 MB)
SUPERTONIC_VOICE=F1
SUPERTONIC_STEPS=10
SUPERTONIC_SPEED=1.15

# Local Vietnamese ASR (first use downloads faster-whisper large-v3-turbo, about 1.6 GB)
ASR_MODEL=large-v3-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=5

# API
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/flatmate.db

# Simulation
SIMULATION_SEED=42
SIMULATION_TICK_SECONDS=2
SIMULATION_MINUTES_PER_TICK=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
